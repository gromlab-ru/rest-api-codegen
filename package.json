{
  "name": "@gromlab/rest-api-codegen",
  "version": "5.2.3",
  "description": "Generate framework-agnostic TypeScript REST SDKs from OpenAPI specifications",
  "type": "module",
  "packageManager": "npm@11.16.0",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "rest-api-codegen": "dist/cli.js"
  },
  "files": [
    "dist",
    "package.json"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "npm run clean && tsc -p tsconfig.build.json && node scripts/copy-templates.mjs",
    "build:skills": "node src/skills/registry.mjs --build",
    "check:skills": "node src/skills/registry.mjs --check",
    "clean": "node scripts/clean.mjs",
    "dev": "npm run build && node dist/cli.js",
    "start": "node dist/cli.js",
    "test:release": "node --test tests/release-contract.test.mjs",
    "typecheck": "tsc -p tsconfig.check.json && tsc -p tsconfig.test.json",
    "test": "npm run build && vitest run",
    "test:watch": "npm run build && vitest",
    "test:coverage": "npm run build && vitest run --coverage",
    "prepare:package": "npm run typecheck && npm run build",
    "verify": "npm run test:release && npm run check:skills && npm run typecheck && npm run test:coverage",
    "prepack": "npm run prepare:package"
  },
  "dependencies": {
    "@biomejs/js-api": "6.0.0",
    "@biomejs/wasm-nodejs": "2.5.2",
    "chalk": "^5.3.0",
    "commander": "^12.1.0",
    "eta": "3.5.0",
    "swagger-typescript-api": "13.12.6"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "^4.1.10",
    "typescript": "^5",
    "vitest": "^4.1.10"
  },
  "keywords": [
    "openapi",
    "swagger",
    "api",
    "codegen",
    "typescript",
    "generator",
    "cli"
  ],
  "author": "S.Gromov",
  "license": "MIT",
  "homepage": "https://github.com/gromlab-ru/rest-api-codegen",
  "repository": {
    "type": "git",
    "url": "https://github.com/gromlab-ru/rest-api-codegen"
  },
  "bugs": {
    "url": "https://github.com/gromlab-ru/rest-api-codegen/issues"
  }
}
